# Copia este archivo como .env y escribe tu clave real.
# Nunca subas el archivo .env a GitHub.

OPENAI_API_KEY=sk-tu-clave-aqui

# Opcionales
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_REASONING_EFFORT=low
# ALLOWED_ORIGIN=https://tu-proyecto.vercel.app
# Límite de análisis por IP: RATE_LIMIT_REQUESTS cada RATE_LIMIT_WINDOW_SECONDS
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=600
# Tope total entre todos los visitantes: GLOBAL_LIMIT_REQUESTS cada GLOBAL_LIMIT_WINDOW_SECONDS
# GLOBAL_LIMIT_REQUESTS=100
# GLOBAL_LIMIT_WINDOW_SECONDS=86400
